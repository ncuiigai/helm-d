{
  "name": "dsh-profile-desktop",
  "private": true,
  "dependencies": {
    "@adwmc/helm-d": "https://github.com/ncuiigai/helm-d/releases/download/v0.7.1/helm-d.tgz",
    "@deepseek-ai/dsh-subagent-claude-code": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent-codex": "0.2.2-rc.5",
    "@local/dsh-narrating-preset": "link:C:/AI/dsh-dev-tuning/narrating-preset",
    "dsh-config-manager": "0.12.0",
    "dsh-context": "0.87.1",
    "dsh-cost-meter": "1.9.89",
    "dsh-rewind-plugin": "0.24.1",
    "dsh-tinyfish-search": "0.23.0",
    "dshmarket": "1.84.1"
  },
  "dsh": {
    "profile": {
      "bundles": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-web-app",
        "@deepseek-ai/dsh-experimental-auto-review",
        "@deepseek-ai/dsh-experimental-inspector-profile",
        "@deepseek-ai/dsh-experimental-tool-worktree",
        "@deepseek-ai/dsh-experimental-terminal-bundle",
        "@deepseek-ai/dsh-experimental-session-search",
        "@deepseek-ai/dsh-experimental-session-titles-bundle",
        "@deepseek-ai/dsh-experimental-ralph-bundle",
        "@deepseek-ai/dsh-experimental-plugin-market-bundle",
        "@local/dsh-narrating-preset",
        "@deepseek-ai/dsh-personalized-recommendations",
        "@deepseek-ai/dsh-subagent-codex",
        "@deepseek-ai/dsh-subagent-claude-code",
        "dsh-config-manager",
        "dsh-context",
        "dsh-cost-meter",
        "dshmarket",
        "dsh-rewind-plugin",
        "dsh-tinyfish-search",
        "@adwmc/helm-d"
      ],
      "patchReload": "live"
    }
  }
}